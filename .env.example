# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Contoh Konfigurasi)
# Salin file ini menjadi .env dan isi dengan kredensial yang valid.
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT NILAI ASLI KE SISTEM KONTROL VERSI.
# ==============================================================================

# Amazon Location Service (AWS) Credentials & Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_LOCATION_ROUTE_CALCULATOR_NAME=AmbulanceRouteCalculator

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://your_broker_host:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Local / MySQL Database Configuration (jika digunakan)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=ambulans
DB_PORT=3306

# PostgreSQL (Neon Database) - Primary
# Pooler URL untuk query reguler
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.neon.tech/ambulans?sslmode=require
# Direct URL untuk koneksi LISTEN/NOTIFY persistent
DATABASE_DIRECT_URL=postgresql://user:password@endpoint.region.neon.tech/ambulans?sslmode=require

# PostgreSQL (Neon Database) - Backup / Failover
DATABASE_URL_BACKUP=postgresql://user:password@backup-endpoint-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_DIRECT_URL_BACKUP=postgresql://user:password@backup-endpoint.region.neon.tech/neondb?sslmode=require

